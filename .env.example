# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by /api/parse-syllabus. Without it that route returns a
# clear error and the rest of the app is unaffected.
ANTHROPIC_API_KEY=

# DLSU AnimoSpace. Also the origin the sync endpoint accepts cross-origin posts from.
NEXT_PUBLIC_CANVAS_ORIGIN=https://dlsu.instructure.com
