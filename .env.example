# Supabase (Project Settings -> API). Both have committed defaults in
# lib/config.ts, so you only need these to point a clone at your own project.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Used by /api/parse-syllabus. Get one from aistudio.google.com.
# Without it that route returns a clear error and nothing else is affected.
GEMINI_API_KEY=
# Optional: override the model, e.g. a cheaper gemini-3.5-flash-lite.
GEMINI_MODEL=gemini-3.8-flash

# DLSU AnimoSpace. Also the origin the sync endpoint accepts cross-origin posts from.
NEXT_PUBLIC_CANVAS_ORIGIN=https://dlsu.instructure.com
